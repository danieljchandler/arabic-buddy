# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# These are bundled into the client — never put secrets here.
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
# Web push. Generate a pair once with `npx web-push generate-vapid-keys`; the
# public half goes here, the private half is an edge-function secret
# (VAPID_PRIVATE_KEY) alongside VAPID_PUBLIC_KEY and VAPID_SUBJECT. Leave blank
# to ship without push — the Settings toggle hides itself when it's unset.
VITE_VAPID_PUBLIC_KEY=

VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# PostHog analytics (optional — analytics won't fire without this)
VITE_POSTHOG_KEY="phc_your_posthog_key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# ─── Supabase Edge Function Secrets ──────────────────────────────────────────
# Set via: supabase secrets set KEY=value
# These are auto-provided by Supabase runtime:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# AI / LLM providers
# Powers the live voice call (realtime-session-token) over WebRTC. That call is
# the one place Munsit can't serve: the Realtime API ships a fixed set of eight
# personas and the dialect comes from the system prompt, not the voice.
OPENAI_API_KEY="sk-..."
# Yemeni shares Gulf's "ballad" persona by default. Set this to tell them apart
# on a call — "ash" is the nearest warm male alternative.
REALTIME_VOICE_YEMENI=""
OPENROUTER_API_KEY="sk-or-..."
GEMINI_API_KEY="your_gemini_api_key"
LOVABLE_API_KEY="your_lovable_api_key"
# Dialect validation asks Arabic-native Mistral Saba (OpenRouter) first and
# escalates to Gemini 2.5 Pro only when it isn't confident. Set to "off" to use
# Gemini 2.5 Pro alone.
DIALECT_VALIDATOR_CROSSCHECK=""

# Speech & Audio
AZURE_SPEECH_KEY="your_azure_speech_key"
AZURE_SPEECH_REGION="eastus"
# Honored by Azure TTS, pronunciation assessment AND the video pipeline's ASR
# leg. Set this when the deployment uses an Azure AI multi-service resource;
# it takes precedence over AZURE_SPEECH_REGION everywhere.
AZURE_SPEECH_ENDPOINT="https://eastus.api.cognitive.microsoft.com"
# ElevenLabs powers both TTS and the Scribe ASR leg on the same key.
ELEVENLABS_API_KEY="your_elevenlabs_api_key"
# Optional overrides — leave unset for the defaults noted.
ELEVENLABS_TTS_MODEL=""   # default eleven_multilingual_v2; set eleven_v3 to A/B
ELEVENLABS_STT_MODEL=""   # default scribe_v2
DEEPGRAM_API_KEY="your_deepgram_api_key"
SONIOX_API_KEY="your_soniox_api_key"
MUNSIT_API_KEY="your_munsit_api_key"
MUNSIT_ASR_MODEL=""       # default "munsit"; set "munsit-en-ar" for code-switched audio
# Munsit's Faseeh model serves every dialect's TTS. Leave unset to resolve it
# from GET /models; pin it if a faster "mini" model appears that can't serve
# cloned voices.
MUNSIT_TTS_MODEL_ID=""    # e.g. faseeh-v1-preview
# Per-dialect voice pins, comma-separated, in speaker-slot order. Leave unset
# and voices are matched from GET /voices by their `dialect` tag.
#
# MUNSIT_YEMENI_VOICE_IDS is the one that matters most. Munsit has no Yemeni
# voice, so Yemeni borrows a Gulf one (rotated so it doesn't lead with the same
# voice Gulf uses) — the wrong accent family, but far closer and more natural
# than Azure's ar-YE-* neurals. Setting this to a cloned voice from
# POST /voices/clone switches every Yemeni surface over with no redeploy, and it
# is the ONLY way to reach a clone: Munsit returns null for gender/dialect/type
# on cloned voices, so tag matching can never find one.
MUNSIT_YEMENI_VOICE_IDS=""
MUNSIT_GULF_VOICE_IDS=""
MUNSIT_EGYPTIAN_VOICE_IDS=""
MUNSIT_MSA_VOICE_IDS=""
# The pre-existing single-value form, still read as a one-element Gulf pin.
MUNSIT_GULF_VOICE_ID=""
# Per-dialect rollback lever: "auto" (default) | munsit | azure | elevenlabs.
# TTS_PROVIDER_YEMENI=azure restores the old ar-YE-* voices instantly.
TTS_PROVIDER_GULF=""
TTS_PROVIDER_EGYPTIAN=""
TTS_PROVIDER_YEMENI=""
TTS_PROVIDER_MSA=""
# Let one pinned voice speak every role in a multi-speaker Listen episode.
# Off by default: with a single cloned voice, both podcast hosts would sound
# identical, which is worse than the borrowed-accent compromise.
TTS_ALLOW_SINGLE_VOICE_EPISODES=""
# Cohere Transcribe Arabic — optional ASR leg. The pipeline skips it entirely
# when the key is unset, so it can be piloted before any engine cutover.
COHERE_API_KEY=""
COHERE_STT_MODEL=""       # default cohere-transcribe-arabic-07-2026

# NLP / Translation
FANAR_API_KEY="your_fanar_api_key"
# Required — the Farasa WebAPI no longer serves anonymous traffic. Without it
# every diacritization call comes back "invalid api key. please register at
# farasa.qcri.org" and transcripts carry no Farasa tashkeel at all
# (engines_used.diacritization then reads reason: "invalid_api_key").
FARASA_API_KEY="your_farasa_api_key"
# Powers CAMeL-Lab dialect ID, the only non-LLM check on the detected dialect.
# Unset, dialect confidence rests entirely on the LLM + Fanar.
HUGGINGFACE_API_KEY="hf_..."
JINA_API_KEY="jina_..."

# Media & Content
RAPIDAPI_KEY="your_rapidapi_key"
YOUTUBE_API_KEY="your_youtube_api_key"
COBALT_API_KEY="your_cobalt_api_key"
FIRECRAWL_API_KEY="your_firecrawl_api_key"

# Payments
STRIPE_SECRET_KEY="sk_live_or_test_..."

# Security
ALLOWED_ORIGINS="https://your-domain.com,http://localhost:5173"

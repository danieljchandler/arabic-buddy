/*
  Permissions-Policy: microphone=*

# The loading emblem is unhashed and served straight from public/, so it needs
# an explicit immutable directive. Version it by changing the filename — but not
# with a hyphenated suffix, which would make it match sw.js's isHashedAsset
# pattern and route it back through Cache Storage.
/assets/loading-emblem.mp4
  Cache-Control: public, max-age=31536000, immutable

/assets/loading-emblem.webm
  Cache-Control: public, max-age=31536000, immutable

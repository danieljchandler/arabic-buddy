{
  "name": "Hakiya \u2014 Learn Spoken Arabic",
  "short_name": "Hakiya",
  "description": "Learn real spoken Arabic \u2014 Gulf, Egyptian, and Yemeni dialects \u2014 with native audio, smart flashcards, and lessons built from real media.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F9F7F2",
  "theme_color": "#F9F7F2",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "audio/*",
            "video/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Review due cards",
      "short_name": "Review",
      "url": "/review",
      "description": "Start today's spaced-repetition session"
    },
    {
      "name": "Practice",
      "short_name": "Practice",
      "url": "/practice",
      "description": "Speaking, listening and reading practice"
    }
  ]
}
